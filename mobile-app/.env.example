# Optional override for backend API base URL.
# Use your machine LAN IP so Expo Go on phone can reach the backend.
# Example: http://192.168.26.103:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=

# Optional pieces used when EXPO_PUBLIC_API_BASE_URL is empty.
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_PREFIX=/api/v1
